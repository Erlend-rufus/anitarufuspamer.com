---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set u = i18n.no.site.url %}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ u }}/</loc></url>
  <url><loc>{{ u }}/portretter/</loc></url>
  {%- for ex in i18n.no.exhibitions %}
  <url><loc>{{ u }}{{ ex.urlNo }}</loc></url>
  {%- endfor %}
  <url><loc>{{ u }}/en/</loc></url>
  <url><loc>{{ u }}/en/portraits/</loc></url>
  {%- for ex in i18n.no.exhibitions %}
  <url><loc>{{ u }}{{ ex.urlEn }}</loc></url>
  {%- endfor %}
</urlset>
