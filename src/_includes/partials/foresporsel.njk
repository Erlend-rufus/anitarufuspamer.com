{%- set L = i18n[lang] %}
<section class="inquiry" id="foresporsel">
  <div class="inquiry__intro">
    <h2 class="inquiry__title">{{ L.ui.inquiry.title }}</h2>
    {%- if L.site.inquiryText %}<p>{{ L.site.inquiryText }}</p>{% endif %}
  </div>
  <form class="inquiry__form" name="foresporsel" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-inquiry-form novalidate>
    <input type="hidden" name="form-name" value="foresporsel">
    <input type="hidden" name="sprak" value="{{ lang }}">
    <p class="visually-hidden"><label>{{ L.ui.inquiry.honeypot }} <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
    <label class="field">{{ L.ui.inquiry.work }}<input name="verk" value="{{ inquiryDefault }}" readonly data-inquiry-work></label>
    <label class="field">{{ L.ui.inquiry.name }}<input name="navn" autocomplete="name" required></label>
    <label class="field">{{ L.ui.inquiry.email }}<input name="e-post" type="email" autocomplete="email" required></label>
    <label class="field">{{ L.ui.inquiry.message }}<textarea name="melding" rows="3"></textarea></label>
    <p class="inquiry__error" role="alert" data-inquiry-error hidden></p>
    <button class="btn btn--submit" type="submit" data-inquiry-submit>{{ L.ui.inquiry.send }}</button>
  </form>
</section>
