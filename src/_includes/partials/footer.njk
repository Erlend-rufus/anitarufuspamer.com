{%- set L = i18n[lang] %}
<footer class="footer" id="kontakt">
  <span>© {{ L.site.name }}</span>
  <span class="footer__links">
    {%- if L.site.phone %}<a href="tel:{{ L.site.phone | replace(' ', '') }}">{{ L.site.phone }}</a>{% endif %}
    {%- if L.site.email %}<a href="mailto:{{ L.site.email }}">{{ L.site.email }}</a>{% endif %}
  </span>
</footer>
