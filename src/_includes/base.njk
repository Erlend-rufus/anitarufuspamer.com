<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " · " + site.name) if title else site.name %}
{%- set pageDesc = description or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="nb_NO">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- set og = ogSrc or (site.heroWorks[0].image if site.heroWorks.length) %}
{%- if og %}
<meta property="og:image" content="{{ site.url }}{% ogbilde og %}">
<meta name="twitter:card" content="summary_large_image">
{%- endif %}
<link rel="preload" href="/fonts/pt-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/fira-sans-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/site.css">
<script>document.documentElement.classList.add("js")</script>
<script src="/js/site.js" defer></script>
</head>
<body class="{{ bodyClass }}">
<a class="skip-link" href="#innhold">Hopp til innhold</a>
{% include "partials/topplinje.njk" %}
{% include "partials/dybdemal.njk" %}
<div class="page" id="innhold">
{{ content | safe }}
{%- if not hideFooter %}
{% include "partials/footer.njk" %}
{%- endif %}
</div>
</body>
</html>
